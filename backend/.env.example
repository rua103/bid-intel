DATABASE_PATH=.data/bidintel.db
MAX_UPLOAD_MB=50
# Comma-separated extra frontend origins for non-LAN deployments.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional OpenAI-compatible Qwen/DeepSeek endpoint. Keep credentials in .env.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_MAX_CHARS=12000
MODEL_MAX_OUTPUT_TOKENS=4096
# 模型抽取走流式（SSE）：MODEL_TIMEOUT_SECONDS 是「两个数据块之间的最大间隔」，
# 不是整段生成的总时长上限；生成时长由 MODEL_MAX_OUTPUT_TOKENS 约束。
MODEL_TIMEOUT_SECONDS=120
# 兜底：防止服务端无限推流。正常生成远小于该值。
MODEL_STREAM_TOTAL_SECONDS=600
# 关闭模型推理（必须走 chat_template_kwargs，顶层同名字段会被网关忽略）。
# 实测：关闭前单条 ~5000 推理 token / 208 秒 / JSON 被截断；关闭后推理 0 / ~35 秒 / JSON 完整。
# 换到不接受该字段的端点时可设为 false。
MODEL_DISABLE_THINKING=true
EXTRACTION_MODE=hybrid
OCR_ENABLED=false
OCR_LANGUAGE=chi_sim+eng
OCR_TIMEOUT_SECONDS=30
# 旧版 DOC 需要 LibreOffice；留空自动检测 PATH 和常见安装目录。
LIBREOFFICE_PATH=
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=120
# 本机大批量后台任务
INTAKE_ROOT=
JOB_WORKERS=3
JOB_MAX_EXPANDED_MB=2048
JOB_MAX_MEMBER_MB=512
JOB_MAX_ARCHIVE_DEPTH=8
JOB_MAX_ARCHIVE_FILES=20000
OCR_ENGINE=rapidocr
PDF_MAX_PAGES=1000
PDF_MAX_OCR_PAGES=1000
# 评审账号登录（演示部署时设为 true，并在本机 .env 配置强密码和随机签名密钥）。
AUTH_ENABLED=false
AUTH_USERNAME=reviewer
AUTH_PASSWORD=
AUTH_SECRET_KEY=
AUTH_SESSION_HOURS=8
AUTH_COOKIE_SECURE=false

# Optional Neo4j CLI, independent of the app's saved model configuration.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
